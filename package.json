{
  "name": "wincapture-studio",
  "version": "0.1.0",
  "private": true,
  "description": "WinCapture Studio - Windows 录屏与教程制作工具",
  "author": "WinCapture Studio",
  "license": "UNLICENSED",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "node scripts/vite-run.mjs build",
    "build": "npm run build:native && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:native && npm run build:main && node scripts/vite-run.mjs dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run verify:ipc",
    "doctor": "node scripts/doctor.mjs",
    "verify:ipc": "node scripts/check-ipc-contract.mjs",
    "verify:capture": "node scripts/probe-grabber.mjs && node scripts/probe-audio.mjs",
    "verify:e2e": "npm run build && node scripts/run-electron.mjs scripts/verify-e2e.cjs",
    "verify:ui": "node scripts/run-electron.mjs scripts/verify-ui.cjs",
    "verify:stage-fit": "node scripts/run-electron.mjs scripts/verify-stage-fit.cjs",
    "verify:layout": "node scripts/run-electron.mjs scripts/verify-layout.cjs",
    "verify:icon": "node scripts/run-electron.mjs scripts/verify-icon.cjs",
    "verify:overlay": "node scripts/run-electron.mjs scripts/verify-overlay.cjs",
    "verify:exporter": "node scripts/run-electron.mjs scripts/verify-exporter.cjs",
    "verify:parity": "node scripts/run-electron.mjs scripts/verify-parity.cjs",
    "verify:remaining": "node scripts/run-electron.mjs scripts/verify-remaining.cjs",
    "verify:record": "npm run build && node scripts/verify-record.mjs",
    "verify:camera": "node scripts/run-electron.mjs scripts/verify-camera.cjs",
    "verify:wp-f": "node scripts/run-electron.mjs scripts/verify-wp-f.cjs",
    "verify:all": "npm run verify:ui && npm run verify:stage-fit && npm run verify:layout && npm run verify:overlay && npm run verify:icon",
    "pack": "npm run build && node scripts/package.mjs",
    "pack:dir": "npm run build && node scripts/package.mjs --dir",
    "verify:package": "node scripts/verify-package.cjs",
    "release": "npm run pack && npm run verify:package && npm run verify:packaged-start",
    "verify:input-camera": "node scripts/verify-input-camera.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:longrun": "node scripts/verify-longrun.mjs",
    "verify:packaged-start": "node scripts/verify-packaged-start.mjs",
    "verify:capture-perf": "node scripts/run-electron.mjs scripts/verify-capture-performance.cjs",
    "verify:pointer-desktop": "node scripts/run-electron.mjs scripts/verify-pointer-desktop.cjs"
  },
  "dependencies": {
    "mediabunny": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
