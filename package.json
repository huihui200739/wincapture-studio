{
  "name": "wincapture-studio",
  "version": "0.1.0",
  "private": true,
  "description": "WinCapture Studio - Windows 录屏与教程制作工具",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:native && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:native && npm run build:main && vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:capture": "node scripts/probe-grabber.mjs && node scripts/probe-audio.mjs",
    "verify:e2e": "npm run build && electron --no-sandbox scripts/verify-e2e.cjs"
  },
  "dependencies": {
    "mediabunny": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^45.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
